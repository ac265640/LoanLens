# Copy to .env (gitignored). All optional; defaults shown.
# Read by scripts/deploy_frontend.sh. AWS credentials do NOT go here:
# use `aws configure` (writes ~/.aws/credentials) or export AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_PROFILE in your shell.
AWS_REGION=us-east-1
STACK_NAME=loanlens
AMPLIFY_APP_NAME=loanlens
AMPLIFY_BRANCH=main
